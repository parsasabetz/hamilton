{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "tabWidth": 2,
  "sortTailwindcss": {},
  "endOfLine": "lf",
  "checkIgnorePragma": true,
  "printWidth": 80,
  "sortPackageJson": true,
  "insertFinalNewline": true,
  "ignorePatterns": [
    ".gitignore",
    "**/node_modules/**",
    "**/.turbo/**",
    "pnpm-lock.yaml",
    "bun.lockb",
    "package-lock.json",
    "yarn.lock",
    "**/dist/**",
    ".cache",
    "coverage",
    ".pnpm",
    "**/*.tsbuildinfo",
    ".deploy-output.json",
    "*.log",
    "npm-debug.log*",
    "yarn-debug.log*",
    "yarn-error.log*",
    "coverage/**",
    ".idea",
    ".vscode",
    ".DS_Store",
    "**/*.gen.ts"
  ]
}
